{
  "name": "gcch",
  "version": "1.0.0",
  "description": "Google Chat Code Highlighter - syntax highlighting and copy buttons for code blocks in Google Chat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9"
  },
  "scripts": {
    "icons": "tsx scripts/make-icons.ts",
    "prebuild": "pnpm run icons",
    "build": "vite build --mode content && vite build --mode popup",
    "dev": "pnpm run icons && vite build --mode content --watch",
    "package": "pnpm run build && tsx scripts/package.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "jiti": "^2.4.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11"
  }
}
