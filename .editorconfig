root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Captured Chat markup. Its exact bytes are the test - never reformat it.
[tests/fixtures/*.html]
insert_final_newline = false
trim_trailing_whitespace = false
